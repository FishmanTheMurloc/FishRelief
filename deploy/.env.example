# 上游 chat completions 地址（必填）。必须以 /chat/completions 结尾，网关据此推导 /v1/models
Upstream__Endpoint=https://api.example.com/v1/chat/completions

# 上游 token（必填）
Upstream__ApiKey=sk-replace-me

# 清单目录 ./manifests 挂载到容器 /manifests，这里指向其中的 local 子目录；模板必须与 manifest.json 同目录
Manifest__Path=/manifests/local/manifest.json

# 台账（JSON Lines）。默认 logs/audit-.jsonl，即落在日志卷中
Audit__Path=/app/logs/audit-.jsonl
Audit__RetainedFileCountLimit=90

# 必须为 Production；Development 会读到 appsettings.Development.json 里的 localhost:3000
ASPNETCORE_ENVIRONMENT=Production

# 日志与台账时间戳使用本地时区
TZ=Asia/Shanghai

# 调试端点（/debug/manifest 与 /debug/rewrite）：默认关闭，不注册即访问 404，可不填。
# 需要时显式开启；开启后无鉴权，仅限本地调试，切勿暴露在公网。
#Debug__EndpointsEnabled=false
